{
  "manifest_version": 3,
  "name": "书引 AI · NotebookLM 音频助手",
  "version": "1.0.0",
  "description": "只接管书引 AI 明确启动的 Gemini Notebook / NotebookLM 音频任务。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["alarms", "downloads", "nativeMessaging", "storage", "tabs"],
  "host_permissions": ["https://notebook.google.com/*", "https://notebooklm.google.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "书引 AI 音频助手", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://notebook.google.com/*", "https://notebooklm.google.com/*"],
      "js": ["content-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
